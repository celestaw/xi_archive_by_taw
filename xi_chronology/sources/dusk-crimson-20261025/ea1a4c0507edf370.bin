          var timeTitle = String(dates[3]) + "." + String(Months[dates[1]]) + "." + String(dates[2]) + " " + String(dates[0]) + " "+ String(times[0]) + ":" + String(times[1]);
        %>
        <% if (pickupCount <= withImageLimit) { %>
        <li class="item item--box">
          <a data-click-url="<%- article.click_url %>" class="link" href="<%- article.url %>">
            <article class="pickup-content">
              <img class="figure" src="<%- image %>" alt="<%- title %>">
              <span class="figcaption"><%- title %><time class="date" datetime="<%- timeTag %>"><%- timeTitle %></time></span>
            </article>
          </a>
        </li>
        <% } %>
        <% if (pickupCount > withImageLimit) { %>
          <li class="item item--line">
            <a data-click-url="<%- article.click_url %>" class="link" href="<%- article.url %>">
              <%- title %><time class="date" datetime="<%- timeTag %>"><%- timeTitle %></time>
            </a>
          </li>
        <% } %>
      <% }); %>
    </ul>
  </script>
