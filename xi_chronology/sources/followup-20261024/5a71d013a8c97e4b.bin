		<!-- animations -->
		<script type="text/javascript" src="https://code.jquery.com/jquery-1.11.1.min.js"></script>
		<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js"></script>

		<!--fakeloader-->
		<link href="../asset/css/fakeLoader.css" rel="stylesheet" type="text/css">

		<!-- webfont -->
		<link href="https://fonts.googleapis.com/css?family=Sawarabi+Mincho" rel="stylesheet">

		<!--fakeloader-->
		<script src="../asset/js/fakeLoader.min.js"></script>
		<script>
			$(document).ready(function(){
				$(".fakeloader").fakeLoader({
					timeToHide:1500,
					bgColor:"#cd2b0f",
					spinner:"spinner2"
				});
			});
		</script>

		<!---fadein--->
		<script type="text/javascript">

			// simple fade
			$(function(){
				$('.fade').hide(); 
			});	  
			
			var i = 0; 
			var int=0; 
			
			$(window).bind("load", function() { 
				var int=setInterval("doFade(i)",1000); 
			});
			
			function doFade() {
				var list = $('.fade').length;
				
				if (i >= list) { 
					clearInterval(int); 
				} 
				
				$('.fade').eq(i).fadeIn(1000); 
				i++; 
			} 
			
			
			$(window).scroll(function() {
				$('#animatedElement').each(function(){
				var imagePos = $(this).offset().top;
				
				var topOfWindow = $(window).scrollTop();
					if (imagePos < topOfWindow + 400) {
						$(this).addClass("slideUp");
					}
				});
			});
			
			// scroll fade
			$(function(){
			    var effect_btm = (screen.height)*0.3; // 画面下からどの位置でフェードさせるか(px)
			    var effect_move = (screen.height)*0.25; // どのぐらい要素を動かすか(px)
			    var effect_time = 200; // エフェクトの時間(ms) 1秒なら1000

			    //親要素と子要素のcssを定義
			    $('.scroll-fade-chain').css({
			        opacity: 0
			    });
			    $('.scroll-fade-chain').children().each(function(){
			        $(this).css({
			            opacity: 0,
			            transform: 'translateY('+ effect_move +'px)',
			            transition: effect_time + 'ms'
			        });
			    });

			    // スクロールまたはロードするたびに実行
			    $(window).on('scroll load', function(){
			        var scroll_top = $(this).scrollTop();
			        var scroll_btm = scroll_top + $(this).height();
			        var effect_pos = scroll_btm - effect_btm;

			        //エフェクトが発動したとき、子要素をずらしてフェードさせる
			        $('.scroll-fade-chain').each( function() {
			            var this_pos = $(this).offset().top;
			            if ( effect_pos > this_pos ) {
			                $(this).css({
			                    opacity: 0.9,
			                    transform: 'translateY(0)'
			                });
			                $(this).children().each(function(i){
			                    $(this).delay(200 + i * 200).queue(function(){	// increment fade time
			                        $(this).css({
			                            opacity: 1,
			                            transform: 'translateY(0)'
			                        }).dequeue();
			                    });
			                });
			            }
			        });
			    });

			});

		</script>

		
	</head>

