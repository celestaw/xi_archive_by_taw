_1Bx1QARkY","visibility":{"types":"12"}}}},"rendererContext":{"loggingContext":{"loggingDirectives":{"trackingParams":"CCMQ0f0TGAAiEwi3voSTwM-XAxVPf_UHHVABGRg=","visibility":{"types":"12"}}}}}},{"videoDescriptionHeaderRenderer":{"channel":{"simpleText":"xi Official"},"views":{"simpleText":"439,032回視聴"},"publishDate":{"simpleText":"2026/10/03"},"factoid":[{"factoidRenderer":{"value":{"simpleText":"1.2万"},"label":{"simpleText":"高評価数"},"accessibilityText":"高評価 1.2万 件","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtWTks4bGVWRnktZyDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"43万"},"label":{"simpleText":"視聴回数"},"accessibilityText":"439,032回視聴","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"10月3日"},"label":{"simpleText":"2026年"},"accessibilityText":"2026/10/03","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","position":"FACTOID_POSITION_LAST"}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAYiEwi3voSTwM-XAxVPf_UHHVABGRjKAQRpNKES","commandMetadata":{"webCommandMetadata":{"url":"/@xiOfficial","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCwzcz476gcGbMnXyxWDUpaA","canonicalBaseUrl":"/@xiOfficial"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/rlDas6vHEXEEDm0awv_unAeYjmRSBVFrTyzfOf2IxKEj7aGiXCEUWyXKGsWXTo3SeLEUhRcJcw=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"もっと見る"}},"simpleText":"...もっと見る"},"showLessText":{"simpleText":"一部を表示"},"attributedDescriptionBodyText":{"content":"「ULTIM@TE☆BE∀M!!」\n\nプロジェクトセカイ カラフルステージ！ feat. 初音ミク\nプロジェクトセカイ Championship 2026 in プロセカ感謝祭\n決勝 書き下ろし楽曲\nhttps://pjsekai.sega.jp/championship2...\n\n\nMusic / Lyrics:\nxi  \n  / com_giko_31  \n   / @xiofficial   \n\nVocal: \n初音ミク\n\nMovie / Illust / Animation:\nTOYCAT\n  / gyalaxtoycat  \n   / @toycat9688   \n\nIllust / Animation:\nこぎのきゐ \n  / kiro247  \n\nうつうつつ\n  / uuchan_dazo  \n\n\nストリーミング：https://linkco.re/09QH755a\n\nオフボーカル+歌詞：https://www.dropbox.com/scl/fi/46wt8i...\n\nニコニコ動画版：https://www.nicovideo.jp/watch/sm4686...\n\n\n-------------------------------------------------\nULTIM@TE☆BE∀M!!\n\nWake up, Beam Maniacs\nRise up, Beam Maniacs\nStand up, Beam Maniacs\nIgnite, the ULTIM@TE☆BE∀M!!\n\n抗えない衝動に\nDesire 最強無敵の一撃を\n\n救われない暴走に\nPrayer 運命(さだめ)捻じるエクスマキナ\n\n崩れゆく世界 歪んでく未来\n終末へ加速するカタルシス\nすべてを打ち砕く 逆転のTrigger\n限界を越えて\n\n収束完了 臨界突破 ミク、撃ちます！\n\nULTIM@TE☆BE∀M!!\nULTIM@TE☆BE∀M!!\n\nYo Yo Yo！ どんなビームが好きですか？\n曲射！ 反射！ 乱射！\nぶっとい直線！\n魂こもったセリフと同時に発射！\n撃って時間差大爆発！\nプラズマ！ ストーム！ オーラ纏って！\n詠唱 魔法陣展開！\n杖から！ 口から！ 目から！笑顔で！\n止められない やめられない\n撃ったもん勝ち トリガーハッピー！\n\nせーのっ！\nULTIM@TE☆BE∀M!!\nULTIM@TE☆BE∀M!!\n全て薙ぎ払う\n幕引きのRadiance\n\nULTIM@TE☆BE∀M!!\nULTIM@TE☆BE∀M!!\n三千世界へ ぶちかませ！\n\nULTIM@TE☆BE∀M!!\n\nWake up, Beam Maniacs\nRise up, Beam Maniacs\nStand up, Beam Maniacs\nIgnite, the ULTIM@TE☆BE∀M!!\n-------------------------------------------------\n\n#VOCALOID #プロセカ #初音ミク","commandRuns":[{"startIndex":100,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwi3voSTwM-XAxVPf_UHHVABGRhI6JeXqt6Sr-lUygEEaTShEg==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUlxb01IYUdEQllMR01aUmllMUFDZzlUQjZQWnxBSTVJdTV0cGk3aFdrRU12RFlydHBkaU5xWklOSTdXdnIzeFNyazZYNi01dVpibEhqWTlqUE5BRnc4dDVYSDdReld3TVhrMUd1MERXWHRmUElqTDI2UXhGZk1pR3Zzb2ZXdWR4\u0026q=https%3A%2F%2Fpjsekai.sega.jp%2Fchampionship2026%2Findex.html\u0026v=VNK8leVFy-g","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUlxb01IYUdEQllMR01aUmllMUFDZzlUQjZQWnxBSTVJdTV0cGk3aFdrRU12RFlydHBkaU5xWklOSTdXdnIzeFNyazZYNi01dVpibEhqWTlqUE5BRnc4dDVYSDdReld3TVhrMUd1ME