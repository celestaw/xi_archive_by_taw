<script type="text/javascript">
if (defineSlotFlux.length) {
    window.fluxtag = {
        readyBids: { prebid: false, google: false },
        failSafeTimeout: 3e3, // 3秒でフェイルセーフ発動
        isFn: function isFn(object) {
            var _t = 'Function';
            var toString = Object.prototype.toString;
            return toString.call(object) === '[object ' + _t + ']';
        },
        launchAdServer: function () {
            if (!fluxtag.readyBids.prebid) {
                return;
            }
            fluxtag.requestAdServer();
        },
        requestAdServer: function () {
            if (!fluxtag.readyBids.google) {
                fluxtag.readyBids.google = true;
                googletag.cmd.push(function () {
                    var pbjsLoaded = !!(window.pbjs && pbjs.que &&
                        fluxtag.isFn(pbjs.que.push) &&
                        (pbjs.libLoaded || (pbjs.setTargetingForGPTAsync &&
                            fluxtag.isFn(pbjs.setTargetingForGPTAsync))));
                    if (pbjsLoaded) {
                        pbjs.que.push(function () {
                            if (pbjs.setTargetingForGPTAsync && fluxtag.isFn(pbjs.setTargetingForGPTAsync)) {
                                try {
                                    Promise.resolve(pbjs.setTargetingForGPTAsync())
                                        .catch(function () {})
                                        .then(function () {
                                            googletag.pubads().refresh();
                                        });
                                } catch (e) {
                                    googletag.pubads().refresh();
                                }
                            } else {
                                googletag.pubads().refresh();
                            }
                        });
                    } else {
                        googletag.pubads().refresh();
                    }
                });
            }
        }
    };

    setTimeout(function () {
        fluxtag.requestAdServer();
    }, fluxtag.failSafeTimeout);
}
</script>
<script>
