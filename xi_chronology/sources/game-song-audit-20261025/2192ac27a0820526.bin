<div class="spacer">&nbsp;</div>
<div class="nobr"><div class="h-scrollable"><table><tbody><tr><td colspan="3" style="text-align:center;"><br class="spacer"><img src="https://cdn.wikiwiki.jp/to/w/arcaea/FrontPage/::ref/arcaea_app_icon.png.webp?rev=73618f3b46483ccdc2d7c56d67512ea0&amp;t=20220714213920" alt="Arcaea" title="Arcaea" width="140" height="140"  loading="lazy"><br class="spacer"><br class="spacer"><a class="ext" href="https://apps.apple.com/jp/app/arcaea/id1205999125" rel="nofollow"><img src="https://cdn.wikiwiki.jp/to/w/arcaea/FrontPage/::ref/DL_AppStore_2.png?rev=ec0a6f78f9b48472df72ae1631f80437&amp;t=20200223184102" alt="App Store" title="App Store" width="107" height="36"  loading="lazy"><span class="system-icon ext pukiwiki-open-uri" data-href="https://apps.apple.com/jp/app/arcaea/id1205999125" data-frame="_blank"></span></a> <a class="ext" href="https://play.google.com/store/apps/details?id=moe.low.arc" rel="nofollow"><img src="https://cdn.wikiwiki.jp/to/w/arcaea/FrontPage/::ref/DL_GooglePlay.png?rev=9f1322d1bc35221a4a791143bb5c810d&amp;t=20170313215655" alt="Google Play" title="Google Play" width="120" height="36"  loading="lazy"><span class="system-icon ext pukiwiki-open-uri" data-href="https://play.google.com/store/apps/details?id=moe.low.arc" data-frame="_blank"></span></a> <a class="ext" href="https://store-jp.nintendo.com/list/software/70010000039850.html" rel="nofollow"><img src="https://cdn.wikiwiki.jp/to/w/arcaea/FrontPage/::ref/switch.png?rev=bc3062106962a28d547f7d88754ac7cf&amp;t=20210613071545" alt="Nintendo Switch" title="Nintendo Switch" width="92" height="36"  loading="lazy"><span class="system-icon ext pukiwiki-open-uri" data-href="https://store-jp.nintendo.com/list/software/70010000039850.html" data-frame="_blank"></span></a><br class="spacer"><br class="spacer"></td></tr><tr><th colspan="2" style="text-align:center; color:white;">アプリ名称</th><td style="text-align:center; width:510px;">Arcaea (アーケア)</td></tr><tr><th colspan="2" style="text-align:center; color:white;">開