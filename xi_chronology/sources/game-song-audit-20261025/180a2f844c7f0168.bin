<script>
googletag.cmd.push(function() {
    if (wi_ismobile && wi_isportrait) {
        var overlaySlot = googletag.defineSlot('/19033742/WIKIWIKI_SP_OVERLAY',[[320,100],[320,50],[1,1]],'div-gpt-ad-1563441919648-0');
        if (overlaySlot) {
            overlaySlot.addService(googletag.pubads());
            // 分母はこの枠だけで数え、空の初回描画にも次回用の印を付ける。
            var overlayRenderHandler = function(event) {
                if (event.slot !== overlaySlot) return;
                overlaySlot.setConfig({ targeting: { wi_refresh: '1' } });
                googletag.pubads().removeEventListener('slotRenderEnded', overlayRenderHandler);
            };
            googletag.pubads().addEventListener('slotRenderEnded', overlayRenderHandler);
        }
    }
    if (wi_isinbound && wi_ismobile && wi_group == "N" && wi_agreement === "false") {
      googletag.defineSlot('/19033742/WIKIWIKI_SP_INBOUND',[[300,250]],
        'div-gpt-ad-1563430750445-0').addService(googletag.pubads());
    } else if (wi_isinbound && wi_group == "N" && wi_agreement === "false") {
