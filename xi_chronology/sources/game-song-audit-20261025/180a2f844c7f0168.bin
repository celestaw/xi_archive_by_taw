                                        <h2 id="h2_content_1_0" >Halcyon  <a class="anchor_super" name ="title"></a> <a class="anchor_super" href="/arcaea/::cmd/edit?page=Halcyon&id=title" rel='nofollow'><span class="system-icon paraedit" title="Edit"></span></a></h2>
<div class="nobr"><div class="h-scrollable"><table><tbody><tr><th colspan="2" style="text-align:center; color:white;">Composer</th><td colspan="3" style="text-align:center;"><a href="/arcaea/%E3%82%B3%E3%83%B3%E3%83%9D%E3%83%BC%E3%82%B6%E3%83%BC%E9%A0%86/P%EF%BD%9EZ#xixi" title="コンポーザー順/P～Z" class="rel-wiki-page">xi</a></td><th style="text-align:center; color:white; width:85px;">Artwork</th><td style="text-align:center;"><a href="/arcaea/%E3%82%A4%E3%83%A9%E3%82%B9%E3%83%88%E3%83%AC%E3%83%BC%E3%82%BF%E3%83%BC%E9%A0%86/%E3%82%A2%E3%83%AB%E3%83%95%E3%82%A1%E3%83%99%E3%83%83%E3%83%88#yamako" title="イラストレーター順/アルファベット" class="rel-wiki-page">yama_ko</a><br class="spacer"><span style="font-size:10px"><span class="wikicolor" style="color:#ffffff; background-color:#292929">※ゲーム内では記載なし</span></span></td></tr><tr><th colspan="2" style="text-align:center; color:white;">Chart<br class="spacer">Designer</th><td colspan="3" style="text-align:center;">東星※太陽</td><td rowspan="10" colspan="2" style="text-align:center;"><img src="https://cdn.wikiwiki.jp/to/w/arcaea/Halcyon/::ref/Halcyon.jpg.webp?rev=92b598ecfbb0adf9f38c91a90c5c6bce&amp;t=20240324040301" alt="Halcyon" title="Halcyon" width="300" height="300"  loading="lazy"></td></tr><tr><th colspan="2" style="text-align:center; color:white;">Difficulty</th><th style="text-align:center; width:90px;"><span class="wikicolor" style="color:aqua"><strong>Past</strong></span></th><th style="text-align:center; width:90px;"><span class="wikicolor" style="color:lime"><strong>Present</strong></span></th><th style="text-align:center; width:90px;"><span class="wikicolor" style="color:fuchsia"><strong>Future</strong></span></th></tr><tr><th colspan="2" style="text-align:center; color:white;">Level</th><td style="text-align:center; width:90px;">5</td><td style="text-align:center; width:90px;">8</td><td style="text-align:center; width:90px;">10</td></tr><tr><th colspan="2" style="text-align:center; color:white;">Notes</th><td style="text-align:center; width:90px;">662</td><td style="text-align:center; width:90px;">943</td><td style="text-align:center; width:90px;">1227</td></tr><tr><th colspan="2" style="text-align:center; color:white;">Length</th><td colspan="3" style="text-align:center;">2:39</td></tr><tr><th colspan="2" style="text-align:center; color:white;">BPM</th><td colspan="3" style="text-align:center;">191</td></tr><tr><th colspan="2" style="text-align:center; color:white;">Pack</th><td colspan="3" style="text-align:center;"><a href="/arcaea/%E3%83%91%E3%83%83%E3%82%AF%E9%A0%86#luminous" title="パック順" class="rel-wiki-page">Luminous Sky</a></td></tr><tr><th colspan="2" style="text-align:center; color:white;">Side</th><td colspan="3" style="background-color:lightskyblue; text-align:center;"><span class="wikicolor" style="color:#000000">Light(光)</span></td></tr><tr><th rowspan="2" style="text-align:center; color:white; width:60px;">Update<br class="spacer">Version</th><th style="text-align:center; color:white; width:60px;">Mobile</th><td colspan="3" style="text-align:center;">ver.1.7.0<br class="spacer">(18/07/16)</td></tr><tr><th style="text-align:center; color:white; width:60px;">Switch</th><td colspan="3" style="text-align:center;">ver.1.0.0c<br class="spacer">(21/05/18)</td></tr></tbody></table></div>
</div>
<div class="spacer">&nbsp;</div>
<div class="h-scrollable"><table><tbody><tr><th rowspan="3" style="text-align:center; color:white; width:140px;"><img src="https://cdn.wikiwiki.jp/to/w/arcaea/%E3%83%91%E3%83%83%E3%82%AF%E9%A0%86/::ref/Lock_white.png?rev=e752bf335d8d67b5c32cfe4d7580c221&amp;t=20210913183325" alt="Requirements" title="Requirements" width="25" height="33"  loading="lazy"><br class="spacer">Requirements</th><th style="color:aqua; text-align:center; width:80px;"><strong>Past</strong></th><td style="text-align:center; width:466px;">-</td></tr><tr><th style="color:lime; text-align:center; width:80px;"><strong>Present</strong></th><td style="text-align:center; width:466px;">50個の欠片</td></tr><tr><th style="color:fuchsia; text-align:center; width:80px;"><strong>Future</strong></th><td style="text-align:center; width:466px;">150個の欠片<br class="spacer"><a href="/arcaea/%E4%B9%9D%E7%95%AA%E7%9B%AE%E3%81%AE%E8%BF%B7%E8%B7%AF" title="九番目の迷路" class="rel-wiki-page">九番目の迷路</a> [<span class="wikicolor" style="color:fuchsia"><strong>FTR</strong></span>] のクリア<br class="spacer"><a href="/arcaea/The%20Message" title="The Message" class="rel-wiki-page">The Message</a> [<span class="wikicolor" style="color:fuchsia"><strong>FTR</strong></span>] のクリア<br class="spacer"><a href="/arcaea/Sulfur" title="Sulfur" class="rel-wiki-page">Sulfur</a> [<span class="wikicolor" style="color:fuchsia"><strong>FTR</strong></span>] のクリア</td></tr></tbody></table></div>
