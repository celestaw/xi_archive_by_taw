{
  "openapi": "3.1.0",
  "info": {
    "title": "xi archive API",
    "description": "非公式作品年表。日付は確認できた公開記録であり、作曲日・真の初公開日とは限らない。",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "summary": "Get Meta",
        "operationId": "getMeta",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveMeta"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/works": {
      "get": {
        "summary": "List Works",
        "operationId": "listWorks",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 1900
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year"
            }
          },
          {
            "name": "date_status",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "dated",
                "undated"
              ],
              "type": "string",
              "default": "all",
              "title": "Date Status"
            }
          },
          {
            "name": "attribution",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "credited",
                "unverified"
              ],
              "type": "string",
              "default": "all",
              "title": "Attribution"
            }
          },
          {
            "name": "medium",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Medium"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 40,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkList"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/works/{work_id}": {
      "get": {
        "summary": "Get Work",
        "operationId": "getWork",
        "parameters": [
          {
            "name": "work_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Work Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkDetail"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alias": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "evidence_status": {
            "type": "string",
            "title": "Evidence Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "kind",
          "evidence_status"
        ],
        "title": "Alias"
      },
      "ApiError": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ApiError"
      },
      "ArchiveMeta": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          },
          "total_entries": {
            "type": "integer",
            "title": "Total Entries"
          },
          "credited_entries": {
            "type": "integer",
            "title": "Credited Entries"
          },
          "dated_entries": {
            "type": "integer",
            "title": "Dated Entries"
          },
          "undated_entries": {
            "type": "integer",
            "title": "Undated Entries"
          },
          "years": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Years"
          },
          "mediums": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Mediums"
          },
          "date_notice": {
            "type": "string",
            "title": "Date Notice"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checked_on",
          "total_entries",
          "credited_entries",
          "dated_entries",
          "undated_entries",
          "years",
          "mediums",
          "date_notice"
        ],
        "title": "ArchiveMeta"
      },
      "AttributionBasis": {
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "primary_credit",
              "unverified"
            ],
            "title": "Verdict"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "inclusion": {
            "items": {
              "$ref": "#/components/schemas/AttributionSource"
            },
            "type": "array",
            "title": "Inclusion"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AttributionSource"
            },
            "type": "array",
            "title": "Sources"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "reviewed_on": {
            "type": "string",
            "title": "Reviewed On"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "verdict",
          "summary",
          "inclusion",
          "sources",
          "limitations",
          "reviewed_on"
        ],
        "title": "AttributionBasis"
      },
      "AttributionSource": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "lead",
              "input"
            ],
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "locator": {
            "type": "string",
            "title": "Locator"
          },
          "credit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credit"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "identity_note": {
            "type": "string",
            "title": "Identity Note"
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "label",
          "url",
          "locator",
          "credit",
          "summary",
          "identity_note",
          "checked_on"
        ],
        "title": "AttributionSource"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "not_found",
              "invalid_request",
              "internal_error"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Health"
      },
      "ListeningLink": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "official_basis": {
            "type": "string",
            "title": "Official Basis"
          },
          "officialness_source_url": {
            "type": "string",
            "title": "Officialness Source Url"
          },
          "availability": {
            "type": "string",
            "title": "Availability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "label",
          "version",
          "official_basis",
          "officialness_source_url",
          "availability"
        ],
        "title": "ListeningLink"
      },
      "PublicationRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date",
            "description": "YYYY / YYYY-MM / YYYY-MM-DD. 不明はnull。保存日時ではない。"
          },
          "precision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "year",
                  "month",
                  "day"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Precision"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "medium": {
            "type": "string",
            "title": "Medium"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          },
          "true_first_publication_confirmed": {
            "type": "boolean",
            "title": "True First Publication Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "date",
          "precision",
          "kind",
          "medium",
          "source_url",
          "evidence",
          "version",
          "checked_on",
          "true_first_publication_confirmed"
        ],
        "title": "PublicationRecord"
      },
      "Relationship": {
        "properties": {
          "work_id": {
            "type": "string",
            "title": "Work Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "evidence_status": {
            "type": "string",
            "title": "Evidence Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "work_id",
          "title",
          "kind",
          "evidence_status"
        ],
        "title": "Relationship"
      },
      "WorkDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "aliases": {
            "items": {
              "$ref": "#/components/schemas/Alias"
            },
            "type": "array",
            "title": "Aliases"
          },
          "credited_name": {
            "type": "string",
            "title": "Credited Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "attribution": {
            "type": "string",
            "enum": [
              "credited",
              "unverified"
            ],
            "title": "Attribution"
          },
          "earliest_record": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PublicationRecord"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_official_listening": {
            "type": "boolean",
            "title": "Has Official Listening"
          },
          "is_variant": {
            "type": "boolean",
            "title": "Is Variant"
          },
          "attribution_basis": {
            "$ref": "#/components/schemas/AttributionBasis"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/PublicationRecord"
            },
            "type": "array",
            "title": "Records"
          },
          "creation_records": {
            "items": {
              "$ref": "#/components/schemas/PublicationRecord"
            },
            "type": "array",
            "title": "Creation Records",
            "description": "作曲・リマスター年などの制作記録。公開履歴や年表の並べ替えには使わない。"
          },
          "listening": {
            "items": {
              "$ref": "#/components/schemas/ListeningLink"
            },
            "type": "array",
            "title": "Listening"
          },
          "relationships": {
            "items": {
              "$ref": "#/components/schemas/Relationship"
            },
            "type": "array",
            "title": "Relationships"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues"
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "aliases",
          "credited_name",
          "role",
          "attribution",
          "earliest_record",
          "has_official_listening",
          "is_variant",
          "attribution_basis",
          "comment",
          "records",
          "creation_records",
          "listening",
          "relationships",
          "issues",
          "checked_on"
        ],
        "title": "WorkDetail"
      },
      "WorkList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "WorkList"
      },
      "WorkSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "aliases": {
            "items": {
              "$ref": "#/components/schemas/Alias"
            },
            "type": "array",
            "title": "Aliases"
          },
          "credited_name": {
            "type": "string",
            "title": "Credited Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "attribution": {
            "type": "string",
            "enum": [
              "credited",
              "unverified"
            ],
            "title": "Attribution"
          },
          "earliest_record": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PublicationRecord"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_official_listening": {
            "type": "boolean",
            "title": "Has Official Listening"
          },
          "is_variant": {
            "type": "boolean",
            "title": "Is Variant"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "aliases",
          "credited_name",
          "role",
          "attribution",
          "earliest_record",
          "has_official_listening",
          "is_variant"
        ],
        "title": "WorkSummary"
      }
    }
  }
}
