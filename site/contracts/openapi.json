          }
        }
      }
    },
    "/api/v1/works/{work_id}/context": {
      "get": {
        "summary": "Get Work Context",
        "operationId": "getWorkContext",
        "parameters": [
          {
            "name": "work_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Work Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkContext"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alias": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "evidence_status": {
            "type": "string",
            "title": "Evidence Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "kind",
          "evidence_status"
        ],
        "title": "Alias"
      },
      "ApiError": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ApiError"
      },
      "ArchiveMeta": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          },
          "total_entries": {
            "type": "integer",
            "title": "Total Entries"
          },
          "credited_entries": {
            "type": "integer",
            "title": "Credited Entries"
          },
          "dated_entries": {
            "type": "integer",
            "title": "Dated Entries"
          },
          "undated_entries": {
            "type": "integer",
            "title": "Undated Entries"
          },
          "years": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Years"
          },
          "mediums": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Mediums"
          },
          "date_notice": {
            "type": "string",
            "title": "Date Notice"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checked_on",
          "total_entries",
          "credited_entries",
          "dated_entries",
          "undated_entries",
          "years",
          "mediums",
          "date_notice"
        ],
        "title": "ArchiveMeta"
      },
      "CollectionDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "album",
              "game"
            ],
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "entry_count": {
            "type": "integer",
            "title": "Entry Count"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "release_records": {
            "items": {
              "$ref": "#/components/schemas/PublicationRecord"
            },
            "type": "array",
            "title": "Release Records"
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/CollectionTrack"
            },
            "type": "array",
            "title": "Tracks"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "category",
          "entry_count",
          "source_url",
          "release_records",
          "checked_on",
          "tracks",
          "note"
        ],
        "title": "CollectionDetail"
      },
      "CollectionList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CollectionSummary"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CollectionList"
      },
      "CollectionSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "album",
              "game"
            ],
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "entry_count": {
            "type": "integer",
            "title": "Entry Count"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "release_records": {
            "items": {
              "$ref": "#/components/schemas/PublicationRecord"
            },
            "type": "array",
            "title": "Release Records"
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "category",
          "entry_count",
          "source_url",
          "release_records",
          "checked_on"
        ],
        "title": "CollectionSummary"
      },
      "CollectionTrack": {
        "properties": {
          "work_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Work Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "credited_name": {
            "type": "string",
            "title": "Credited Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "attribution": {
            "type": "string",
            "enum": [
              "credited",
              "unverified"
            ],
            "title": "Attribution"
          },
          "disc": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disc"
          },
          "track_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Number"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          },
          "listening": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ListeningLink"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "listing_kind": {
            "type": "string",
            "enum": [
              "収録",
              "BMS登録",
              "公式許諾曲",
              "追加告知",
              "大会向け提供",
              "収録候補"
            ],
            "title": "Listing Kind",
            "default": "収録"
          },
          "edition": {
            "type": "string",
            "title": "Edition",
            "default": ""
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "primary",
              "primary_reproduction",
              "secondary"
            ],
            "title": "Source Kind",
            "default": "primary"
          },
          "source_label": {
            "type": "string",
            "title": "Source Label",
            "default": ""
          },
          "genre": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Genre"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "work_id",
          "title",
          "credited_name",
          "role",
          "attribution",
          "disc",
          "track_number",
          "source_url",
          "evidence",
          "checked_on",
          "listening",
          "note"
        ],
        "title": "CollectionTrack"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "not_found",
              "invalid_request",
              "internal_error"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "Genre": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "medium": {
            "type": "string",
            "title": "Medium",
            "description": "ジャンル表記を確認した媒体。移植先独自のジャンルとは限らない。"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "checked_on": {
            "type": "string",
            "title": "Checked On"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "medium",
          "source_url",
          "checked_on"
        ],
        "title": "Genre"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Health"
      },
      "ListeningLink": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "official_basis": {
            "type": "string",
            "title": "Official Basis"
          },
          "officialness_source_url": {
            "type": "string",
            "title": "Officialness Source Url"
          },
          "availability": {
            "type": "string",
            "title": "Availability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "label",
          "version",
          "official_basis",
          "officialness_source_url",
          "availability"
        ],
        "title": "ListeningLink"
      },
      "Pronunciation": {
        "properties": {
          "reading": {
            "type": "string",
            "minLength": 1,
            "title": "Reading"
          },
          "basis": {
            "type": "string",
            "enum": [
              "author_suggestion",
              "author_confirmed"
            ],
            "title": "Basis",
            "description": "作者の読み方案と、作者が確定した読みを区別する。推測読みは含めない。"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "source_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
