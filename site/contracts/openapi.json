    "/api/v1/albums/{album_id}": {
      "get": {
        "summary": "Get Album",
        "operationId": "getAlbum",
        "parameters": [
          {
            "name": "album_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Album Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
